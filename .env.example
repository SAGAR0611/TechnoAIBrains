# Resend (https://resend.com) — used by /api/enquiry to send form submissions by email.
RESEND_API_KEY=

# Sender address for outgoing enquiry emails. Resend's shared sandbox sender
# (onboarding@resend.dev) works until you verify your own domain with Resend.
ENQUIRY_FROM_EMAIL="TechnoAIBrains <onboarding@resend.dev>"

# Where enquiry/contact submissions are delivered. Falls back to the address
# in content/site.ts if unset.
ENQUIRY_TO_EMAIL=hello@technoaibrains.com

# Absolute site URL, used for metadata, sitemap, and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://technoaibrains.com
